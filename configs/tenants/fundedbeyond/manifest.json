      "headline": "Educational trading readiness academy",
      "subheadline": "Diagnose readiness, practice skills, and pursue structured learning paths."
    }
  },
  "theme": {
    "tokens": {
      "primary": "#1B2A4A",
      "accent": "#3D7BF0",
      "background": "#0F172A",
      "foreground": "#F8FAFC",
      "radius": "md",
      "modeDefault": "system"
    },
    "assetTokensRef": "approved-brand-tokens-pending-operator-upload"
