{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build"],
  "references": [
    { "path": "../../packages/access" },
    { "path": "../../packages/api" },
    { "path": "../../packages/audit" },
    { "path": "../../packages/auth" },
    { "path": "../../packages/authorization" },
    { "path": "../../packages/core" },
    { "path": "../../packages/db" },
    { "path": "../../packages/domain" },
    { "path": "../../packages/domain/config" },
    { "path": "../../packages/domain/access" },
    { "path": "../../packages/domain/branding" },
    { "path": "../../packages/domain/identity" },
    { "path": "../../packages/domain/tenancy" },
    { "path": "../../packages/events" },
    { "path": "../../packages/membership" },
    { "path": "../../packages/observability" },
    { "path": "../../packages/security" },
    { "path": "../../packages/storage" },
    { "path": "../../packages/tenancy" }
  ]
}
