{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build"],
  "references": [
    { "path": "../../../backend/packages/access" },
    { "path": "../../../backend/packages/api" },
    { "path": "../../../backend/packages/audit" },
    { "path": "../../../backend/packages/auth" },
    { "path": "../../../backend/packages/authorization" },
    { "path": "../../../backend/packages/core" },
    { "path": "../../../backend/packages/db" },
    { "path": "../../../backend/packages/domain" },
    { "path": "../../../backend/packages/domain/config" },
    { "path": "../../../backend/packages/domain/access" },
    { "path": "../../../backend/packages/domain/branding" },
    { "path": "../../../backend/packages/domain/identity" },
    { "path": "../../../backend/packages/domain/tenancy" },
    { "path": "../../../backend/packages/events" },
    { "path": "../../../backend/packages/membership" },
    { "path": "../../../backend/packages/observability" },
    { "path": "../../../backend/packages/security" },
    { "path": "../../../backend/packages/storage" },
    { "path": "../../../backend/packages/tenancy" }
  ]
}
