  tenant_id             String    @db.Uuid
  proctoring_session_id String    @unique @db.Uuid
  membership_id         String    @db.Uuid
  status                String
  method                String
  score                 Decimal?  @db.Decimal(8, 4)
  metadata_json         Json?
  verified_at           DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)

  // Composite tenant foreign keys (audit M3 coverage).
  membership Membership @relation(fields: [tenant_id, membership_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_verifications_membership_id_tenant_fkey")
  proctoring_session ProctoringSession @relation(fields: [tenant_id, proctoring_session_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_verifications_proctoring_session_id_tenant_fkey")

  @@index([tenant_id, membership_id, created_at])
  @@map("identity_verifications")
}

model ProctoringMediaArtifact {
