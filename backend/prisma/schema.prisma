generator client {
  provider = "prisma-client"
  output   = "../packages/db/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantState {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum DispatchStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PublishStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseModuleContentKind {
  STANDARD
  SCORM
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  GRADED
  ABANDONED
  VOIDED
}

enum Visibility {
  PRIVATE
  TENANT
  PUBLIC
  UNLISTED
}

enum ModerationStatus {
  OPEN
  REVIEWING
  ACTIONED
  REJECTED
  CLOSED
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Tenant {
  id                   String      @id @db.Uuid
  slug                 String      @unique
  legal_name           String?
  display_name         String
  state                TenantState @default(PROVISIONING)
  default_locale       String      @default("en")
  default_timezone     String      @default("UTC")
  statement_timeout_ms Int         @default(5000)
  query_budget_json    Json?
  created_at           DateTime    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime    @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?   @db.Timestamptz(6)

  domains                         TenantDomain[]
  memberships                     Membership[]
  member_profiles                 MemberProfile[]
  member_notification_preferences MemberNotificationPreference[]
  proctoring_media_artifacts      ProctoringMediaArtifact[]
  usage_events                    TenantUsageEvent[]

  @@map("tenants")
}

model TenantUsageEvent {
  id           String    @id @db.Uuid
  tenant_id    String    @db.Uuid
  period_start DateTime  @db.Date
  requests     BigInt    @default(0)
  duration_ms  Float     @default(0) @db.DoublePrecision
  emails       BigInt    @default(0)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Pending and processed partial indexes are maintained by migration 116.
  @@index([tenant_id, created_at], map: "tenant_usage_events_tenant_created_idx")
  @@map("tenant_usage_events")
}

model TenantDomain {
  id                String       @id @db.Uuid
  tenant_id         String       @db.Uuid
  hostname          String
  type              String
  status            DomainStatus @default(PENDING)
  is_primary        Boolean      @default(false)
  verification_json Json?
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?    @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, status])
  @@map("tenant_domains")
}

model AuthPrincipal {
  id               String    @id @db.Uuid
  supabase_user_id String    @unique @db.Uuid
  email            String    @unique
  email_normalized String    @unique
  global_status    String    @default("active")
  mfa_enabled      Boolean   @default(false)
  last_login_at    DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)

  memberships             Membership[]
  platform_grants         PlatformOperator[]           @relation("PlatformOperatorPrincipal")
  platform_grants_made    PlatformOperator[]           @relation("PlatformOperatorGrantedBy")
  platform_grants_revoked PlatformOperator[]           @relation("PlatformOperatorRevokedBy")
  relink_requests         AuthPrincipalRelinkRequest[] @relation("RelinkRequestPrincipal")
  relink_decisions        AuthPrincipalRelinkRequest[] @relation("RelinkRequestDecidedBy")

  @@map("auth_principals")
}

/// H7: platform (cross-tenant) role grants.
///
/// Replaces matching an email against PLATFORM_OPERATOR_ASSIGNMENTS, which
/// required a deploy to change and recorded nothing about who granted access.
/// Revocation is a soft revoke so grant history survives an audit question.
model PlatformOperator {
  id                      String    @id @default(uuid()) @db.Uuid
  auth_principal_id       String    @db.Uuid
  role_key                String
  granted_at              DateTime  @default(now()) @db.Timestamptz(6)
  granted_by_principal_id String?   @db.Uuid
  grant_reason            String?
  revoked_at              DateTime? @db.Timestamptz(6)
  revoked_by_principal_id String?   @db.Uuid
  revoke_reason           String?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  principal  AuthPrincipal  @relation("PlatformOperatorPrincipal", fields: [auth_principal_id], references: [id], onDelete: Cascade)
  granted_by AuthPrincipal? @relation("PlatformOperatorGrantedBy", fields: [granted_by_principal_id], references: [id])
  revoked_by AuthPrincipal? @relation("PlatformOperatorRevokedBy", fields: [revoked_by_principal_id], references: [id])

  @@index([role_key])
  @@map("platform_operators")
}

/// H6: a confirmed email signed in under a different Supabase user than the
/// principal it belongs to. Only a platform approval moves the principal.
model AuthPrincipalRelinkRequest {
  id                         String    @id @default(uuid()) @db.Uuid
  auth_principal_id          String    @db.Uuid
  previous_supabase_user_id  String    @db.Uuid
  requested_supabase_user_id String    @db.Uuid
  email_normalized           String
  status                     String    @default("pending")
  attempt_count              Int       @default(1)
  requested_at               DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at               DateTime  @default(now()) @db.Timestamptz(6)
  decided_at                 DateTime? @db.Timestamptz(6)
  decided_by_principal_id    String?   @db.Uuid
  decision_reason            String?
  revoked_platform_grant_id  String?   @db.Uuid

  principal  AuthPrincipal  @relation("RelinkRequestPrincipal", fields: [auth_principal_id], references: [id], onDelete: Cascade)
  decided_by AuthPrincipal? @relation("RelinkRequestDecidedBy", fields: [decided_by_principal_id], references: [id], onDelete: SetNull)

  @@map("auth_principal_relink_requests")
}

model Membership {
  id                       String           @id @db.Uuid
  tenant_id                String           @db.Uuid
  auth_principal_id        String?          @db.Uuid
  status                   MembershipStatus @default(INVITED)
  invited_email_normalized String?
  invite_token_hash        String?
  invite_expires_at        DateTime?        @db.Timestamptz(6)
  accepted_at              DateTime?        @db.Timestamptz(6)
  joined_at                DateTime?        @db.Timestamptz(6)
  suspended_at             DateTime?        @db.Timestamptz(6)
  removed_at               DateTime?        @db.Timestamptz(6)
  archived_at              DateTime?        @db.Timestamptz(6)
  last_active_at           DateTime?        @db.Timestamptz(6)
  created_at               DateTime         @default(now()) @db.Timestamptz(6)
  updated_at               DateTime         @updatedAt @db.Timestamptz(6)

  tenant                   Tenant                         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  auth_principal           AuthPrincipal?                 @relation(fields: [auth_principal_id], references: [id], onDelete: Restrict)
  profile                  MemberProfile?
  notification_preferences MemberNotificationPreference[]

  // Composite tenant foreign keys (audit M3).
  lesson_progress           LessonProgress[]
  enrollments               Enrollment[]
  attempts                  Attempt[]
  proctoring_sessions       ProctoringSession[]
  certificates              Certificate[]
  payment_orders            PaymentOrder[]
  payment_instalment_plans  PaymentInstalmentPlan[]
  sales_coupon_redemptions  SalesCouponRedemption[]
  sales_wallets             SalesWallet[]
  sales_wallet_transactions SalesWalletTransaction[]
  user_roles                UserRole[]
  permission_overrides      PermissionOverride[]

  // Composite tenant foreign keys (audit M3 coverage).
  at_risk_alerts AtRiskAlert[]
  attribution_tokens AttributionToken[]
  badge_awards BadgeAward[]
  batch_memberships BatchMembership[]
  bundle_enrollments BundleEnrollment[]
  comments Comment[]
  competency_score_snapshots CompetencyScoreSnapshot[]
  competency_scores CompetencyScore[]
  competency_signals CompetencySignal[]
  composite_readiness_state CompositeReadinessState[]
  course_reviews CourseReview[]
  custom_field_value_history CustomFieldValueHistory[]
  custom_field_values CustomFieldValue[]
  device_security_alerts DeviceSecurityAlert[]
  device_sessions DeviceSession[]
  diagnostic_sessions DiagnosticSession[]
  gamification_profiles GamificationProfile[]
  grading_tasks GradingTask[]
  group_memberships GroupMembership[]
  identity_verifications IdentityVerification[]
  learner_subscription_enrollments LearnerSubscriptionEnrollment[]
  live_attendance LiveAttendance[]
  marketing_event_registrations MarketingEventRegistration[]
  marketing_newsfeed_saves MarketingNewsfeedSave[]
  marketing_workflow_runs MarketingWorkflowRun[]
  member_balances MemberBalance[]
  mentions Mention[]
  messenger_messages MessengerMessage[]
  mock_test_enrollments MockTestEnrollment[]
  module_scorm_progress ModuleScormProgress[]
  notification_dispatches NotificationDispatch[]
  path_enrollments PathEnrollment[]
  path_step_progress PathStepProgress[]
  point_ledger PointLedger[]
  poll_responses PollResponse[]
  posts Post[]
  practice_responses PracticeResponse[]
  practice_sessions PracticeSession[]
  quest_progress QuestProgress[]
  reactions Reaction[]
  reward_redemptions RewardRedemption[]
  sales_affiliate_commissions_affiliate_membership SalesAffiliateCommission[] @relation("sales_affiliate_commissions_affiliate_membership_id_tenant_fkey")
  sales_affiliate_commissions_buyer_membership SalesAffiliateCommission[] @relation("sales_affiliate_commissions_buyer_membership_id_tenant_fkey")
  sales_affiliate_payouts SalesAffiliatePayout[]
  sales_affiliate_requests SalesAffiliateRequest[]
  sales_affiliates SalesAffiliate[]
  sales_attribution_events SalesAttributionEvent[]
  sales_referral_attributions_referee_membership SalesReferralAttribution[] @relation("sales_referral_attributions_referee_membership_id_tenant_fkey")
  sales_referral_attributions_referrer_membership SalesReferralAttribution[] @relation("sales_referral_attributions_referrer_membership_id_tenant_fkey")
  sales_referral_codes SalesReferralCode[]
  sales_referral_purchase_credits_referee_membership SalesReferralPurchaseCredit[] @relation("sales_referral_purchase_credits_referee_membership_tenant_fkey")
  sales_referral_purchase_credits_referrer_membership SalesReferralPurchaseCredit[] @relation("sales_referral_purchase_credits_referrer_membership_tenant_fkey")
  srs_state SrsState[]
  streak_freezes StreakFreeze[]
  streak_states StreakState[]
  tenant_active_days TenantActiveDay[]
  test_series_enrollments TestSeriesEnrollment[]
  test_series_item_progress TestSeriesItemProgress[]
  whatsapp_conversations WhatsappConversation[]
  zoom_meeting_participants ZoomMeetingParticipant[]

  @@unique([tenant_id, id], map: "memberships_tenant_id_id_key")
  @@unique([tenant_id, auth_principal_id])
  @@index([tenant_id, status])
  @@index([tenant_id, invite_token_hash])
  @@index([tenant_id, last_active_at])
  @@index([auth_principal_id])
  @@map("memberships")
}

model MemberProfile {
  id                 String            @id @db.Uuid
  tenant_id          String            @db.Uuid
  membership_id      String            @unique @db.Uuid
  display_name       String?
  avatar_key         String?
  bio                String?
  timezone           String?
  profile_visibility ProfileVisibility @default(PUBLIC)
  metadata_json      Json?
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?         @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, display_name])
  @@map("member_profiles")
}

model MemberNotificationPreference {
  id             String   @id @db.Uuid
  tenant_id      String   @db.Uuid
  membership_id  String   @db.Uuid
  category_key   String
  enabled        Boolean  @default(true)
  email_enabled  Boolean  @default(true)
  in_app_enabled Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, membership_id, category_key])
  @@index([tenant_id, membership_id])
  @@map("member_notification_preferences")
}

model Permission {
  id          String   @id @db.Uuid
  key         String   @unique
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("permissions")
}

model PermissionBundle {
  id          String   @id @db.Uuid
  key         String   @unique
  name        String
  permissions Json
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("permission_bundles")
}

model Role {
  id                           String    @id @db.Uuid
  tenant_id                    String    @db.Uuid
  key                          String
  name                         String
  is_system                    Boolean   @default(false)
  /// H11: can() skips ownership/relationship predicates for this role.
  /// Replaces matching the literal keys "owner"/"admin" in code.
  bypasses_resource_predicates Boolean   @default(false)
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at                   DateTime? @db.Timestamptz(6)

  /// Partial-unique in the database since migration 029
  /// (roles_tenant_key_active_uq, WHERE deleted_at IS NULL). The model declared
  /// @@index, which is why H11 read as "duplicate keys can race in" — the
  /// constraint was there, the schema just did not say so.

  // Composite tenant foreign keys (audit M3).
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([tenant_id, id], map: "roles_tenant_id_id_key")
  @@unique([tenant_id, key])
  @@map("roles")
}

model RolePermission {
  id             String   @id @db.Uuid
  tenant_id      String   @db.Uuid
  role_id        String   @db.Uuid
  permission_key String
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  // Composite tenant foreign keys (audit M3).
  role Role @relation(fields: [tenant_id, role_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "role_permissions_role_id_tenant_fkey")

  @@unique([tenant_id, role_id, permission_key])
  @@index([tenant_id, permission_key])
  @@map("role_permissions")
}

model UserRole {
  id                        String   @id @db.Uuid
  tenant_id                 String   @db.Uuid
  membership_id             String   @db.Uuid
  role_id                   String   @db.Uuid
  assigned_by_membership_id String?  @db.Uuid
  created_at                DateTime @default(now()) @db.Timestamptz(6)

  // Composite tenant foreign keys (audit M3).
  role       Role       @relation(fields: [tenant_id, role_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "user_roles_role_id_tenant_fkey")
  membership Membership @relation(fields: [tenant_id, membership_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "user_roles_membership_id_tenant_fkey")

  @@unique([tenant_id, membership_id, role_id])
  @@index([tenant_id, role_id])
  @@map("user_roles")
}

model PermissionOverride {
  id             String    @id @db.Uuid
  tenant_id      String    @db.Uuid
  membership_id  String    @db.Uuid
  permission_key String
  effect         String
  reason         String?
  expires_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  // Composite tenant foreign keys (audit M3).
  membership Membership @relation(fields: [tenant_id, membership_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "permission_overrides_membership_id_tenant_fkey")

  @@unique([tenant_id, membership_id, permission_key])
  @@index([tenant_id, permission_key, effect])
  @@map("permission_overrides")
}

model TenantConfig {
  id                 String   @id @db.Uuid
  tenant_id          String   @unique @db.Uuid
  config_json        Json
  current_version_id String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  @@map("tenant_config")
}

model TenantConfigVersion {
  id                       String   @id @db.Uuid
  tenant_id                String   @db.Uuid
  version                  Int
  snapshot_json            Json
  created_by_membership_id String?  @db.Uuid
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenant_id, version])
  @@index([tenant_id, created_at])
  @@map("tenant_config_version")
}

model FeatureFlag {
  id            String   @id @db.Uuid
  key           String   @unique
  default_value Json
  description   String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id              String   @id @db.Uuid
  tenant_id       String   @db.Uuid
  feature_flag_id String   @db.Uuid
  value_json      Json
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, feature_flag_id])
  @@map("feature_flag_overrides")
}

model Entitlement {
  id         String    @id @db.Uuid
  tenant_id  String    @db.Uuid
  key        String
  value_json Json
  source     String
  starts_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, key])
  @@index([tenant_id, key, expires_at])
  @@map("entitlements")
}

model EntitlementGrantHistory {
  id                       String   @id @db.Uuid
  tenant_id                String   @db.Uuid
  entitlement_key          String
  old_value_json           Json?
  new_value_json           Json
  changed_by_membership_id String?  @db.Uuid
  reason                   String?
  occurred_at              DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, entitlement_key, occurred_at])
  @@map("entitlement_grant_history")
}

model TenantSubscription {
  id              String    @id @db.Uuid
  tenant_id       String    @db.Uuid
  plan_name       String
  currency        String    @db.VarChar(3)
  status          String
  duration_type   String
  next_billing_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([tenant_id, status])
  @@map("tenant_subscriptions")
}

model TenantActiveDay {
  tenant_id     String   @db.Uuid
  membership_id String   @db.Uuid
  day           DateTime @db.Date

  // Composite tenant foreign keys (audit M3 coverage).
  membership Membership @relation(fields: [tenant_id, membership_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_active_days_membership_id_tenant_fkey")

  @@id([tenant_id, membership_id, day])
  @@index([tenant_id, day])
  @@map("tenant_active_days")
}

model LearnerBillingConfig {
  tenant_id                String   @id @db.Uuid
  pricing_model            String?
  home_currency            String?
  gst_enabled              Boolean  @default(false)
  gst_number               String?
  gst_percentage           Decimal? @db.Decimal(6, 3)
  invoice_prefix           String?
  invoice_next_number      Int?
  invoice_business_name    String?
  request_billing_address  Boolean  @default(false)
  request_shipping_address Boolean  @default(false)
  request_gstin            Boolean  @default(false)
  request_mobile           Boolean  @default(false)
  updated_at               DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("learner_billing_config")
}

model LearnerBillingLocation {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  name        String
  country     String
  currency    String
  description String?
  status      String   @default("published")
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Composite tenant foreign keys (audit M3 coverage).
  payment_gateways PaymentGateway[]

  @@unique([tenant_id, id], map: "learner_billing_locations_tenant_id_id_key")
  @@index([tenant_id])
  @@map("learner_billing_locations")
}

model FxRate {
  tenant_id      String   @db.Uuid
  base_currency  String
  quote_currency String
  rate           Decimal  @db.Decimal(18, 8)
  as_of          DateTime @db.Date
  fetched_at     DateTime @default(now()) @db.Timestamptz(6)

  @@id([tenant_id, base_currency, quote_currency])
  @@index([tenant_id])
  @@map("fx_rates")
}

model PaymentGateway {
  id                  String   @id @db.Uuid
  tenant_id           String   @db.Uuid
  gateway_key         String
  display_name        String
  user_id             String?
  publishable_key     String?
  secret_ciphertext   String?
  secret_last4        String?
  billing_location_id String?  @db.Uuid
  is_default          Boolean  @default(false)
  is_configured       Boolean  @default(false)
  is_published        Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Composite tenant foreign keys (audit M3 coverage).
  billing_location LearnerBillingLocation? @relation(fields: [tenant_id, billing_location_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_gateways_billing_location_id_tenant_fkey")
  payment_refund_intents PaymentRefundIntent[]

  @@unique([tenant_id, id], map: "payment_gateways_tenant_id_id_key")
  @@unique([tenant_id, gateway_key])
  @@index([tenant_id])
  @@map("payment_gateways")
}

model AuditEntry {
  id                  String   @id @db.Uuid
  tenant_id           String?  @db.Uuid
  actor_membership_id String?  @db.Uuid
  actor_principal_id  String?  @db.Uuid
  action              String
  target_type         String
  target_id           String?
  request_id          String?
  ip_hash             String?
  user_agent_hash     String?
  before_json         Json?
  after_json          Json?
  metadata_json       Json?
  previous_hash       String?
  entry_hash          String
  occurred_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, occurred_at], map: "audit_entries_tenant_occurred_at_idx")
  @@index([tenant_id, action, occurred_at], map: "audit_entries_tenant_action_occurred_at_idx")
  @@map("audit_entries")
