{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "noEmit": false,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "build", ".next"],
  "references": [
    { "path": "../access" },
    { "path": "../audit" },
    { "path": "../authorization" },
    { "path": "../core" },
    { "path": "../db" },
    { "path": "../events" }
  ]
}
