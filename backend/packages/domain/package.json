{
  "name": "@atlas/domain",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*"
    ]
  },
  "scripts": {
    "build": "echo \"No domain build configured yet.\"",
    "lint": "echo \"No domain lint configured yet.\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"No domain tests configured yet.\"",
    "test:unit": "echo \"No domain unit tests configured yet.\"",
    "test:integration": "echo \"No domain integration tests configured yet.\"",
    "test:authorization": "echo \"No domain authorization tests configured yet.\"",
    "test:tenant-isolation": "echo \"No domain tenant-isolation tests configured yet.\"",
    "test:e2e": "echo \"No domain e2e tests configured yet.\""
  },
  "dependencies": {
    "@atlas/api": "workspace:*",
    "@atlas/audit": "workspace:*",
    "@atlas/authorization": "workspace:*",
    "@atlas/core": "workspace:*",
    "@atlas/db": "workspace:*",
    "@atlas/domain-config": "workspace:*",
    "@atlas/events": "workspace:*",
    "@atlas/membership": "workspace:*",
    "@atlas/security": "workspace:*",
    "@atlas/storage": "workspace:*",
    "cron-parser": "^5.8.1",
    "exceljs": "^4.4.0",
    "stripe": "^22.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
