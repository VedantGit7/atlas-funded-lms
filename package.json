{
  "name": "atlas-lms",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas LMS multi-tenant white-label learning platform",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:authorization": "pnpm -r test:authorization",
    "test:tenant-isolation": "pnpm -r test:tenant-isolation",
    "test:e2e": "pnpm -r test:e2e",
    "db:migrate": "pnpm --filter @atlas/db db:migrate",
    "db:seed": "pnpm --filter @atlas/db db:seed",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
