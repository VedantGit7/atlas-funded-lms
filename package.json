{
  "name": "atlas-lms",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas LMS multi-tenant white-label learning platform",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "check:deployment": "tsx --tsconfig backend/apps/api/tsconfig.json scripts/validate-deployment.ts",
    "dev": "node scripts/dev/free-dev-ports.mjs && node scripts/dev/print-essential-urls.mjs && concurrently --kill-others -n backend,frontend,worker \"pnpm run dev:backend\" \"pnpm run dev:frontend\" \"pnpm run worker:outbox\"",
    "dev:frontend": "pnpm --filter @atlas/web dev",
    "dev:backend": "dotenv -e .env.local -- pnpm --filter @atlas/api-app dev",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "build": "pnpm -r build",
    "analyze:web": "pnpm --filter @atlas/web analyze",
    "lint": "node scripts/ci/run-lint.mjs",
    "lint:coverage": "node scripts/ci/check-lint-coverage.mjs",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b",
    "test": "pnpm test:cleanup-boundary && pnpm test:unit && pnpm test:structure && pnpm test:security && pnpm test:events && pnpm test:authorization && pnpm test:routes && pnpm test:integration && pnpm test:db && pnpm test:tenant-isolation && pnpm test:e2e && pnpm test:architecture && pnpm test:performance-tooling && pnpm test:reliability-tooling",
    "test:unit": "vitest run tests/unit",
    "test:integration": "dotenv -e .env.test -- vitest run tests/integration",
    "test:db": "dotenv -e .env.test -- vitest run tests/db",
    "test:routes": "dotenv -e .env.test -- vitest run tests/api tests/ci",
    "test:authorization": "dotenv -e .env.test -- vitest run tests/authorization tests/unit/authorization",
    "test:events": "dotenv -e .env.test -- vitest run tests/unit/events tests/events tests/authorization/audit-outbox-permissions.test.ts",
    "test:tenant-isolation": "dotenv -e .env.test -- vitest run tests/tenant-isolation",
    "test:e2e": "dotenv -e .env.test -- vitest run tests/e2e",
    "test:structure": "vitest run tests/lint-rules",
    "test:security": "vitest run tests/security",
    "test:browser": "playwright test",
    "browser:serve:api": "pnpm --filter @atlas/api-app build && pnpm --filter @atlas/api-app start",
    "browser:serve:web": "pnpm --filter @atlas/web build && pnpm --filter @atlas/web start",
    "e2e:seed-users": "dotenv -e .env.local -- node scripts/e2e/seed-browser-users.mjs",
    "test:browser:update-snapshots": "playwright test --update-snapshots",
    "ci:frontend-api-closure": "node scripts/ci/check-frontend-api-closure.mjs",
    "ci:frontend-api-closure:strict": "node scripts/ci/check-frontend-api-closure.mjs --strict",
    "ci:learner-bundle-boundary": "node scripts/ci/check-learner-bundle-boundary.mjs",
    "db:generate": "prisma generate --config backend/prisma.generate.config.ts",
    "db:generate:ci": "prisma generate --config backend/prisma.generate.config.ts",
    "db:validate": "prisma validate --config backend/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config backend/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config backend/prisma.config.ts",
    "db:migrate:check": "node scripts/guards/check-migrate-status.mjs",
    "db:studio": "prisma studio --config backend/prisma.config.ts",
    "db:seed": "dotenv -e .env.local -- tsx backend/prisma/seeds/index.ts all",
    "ci": "pnpm check:server-authority && pnpm check:contracts && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:route-metadata && pnpm check:prisma-boundary && pnpm check:audit-compliance && pnpm check:outbox-compliance && pnpm check:outbox-worker && pnpm ci:audit-metadata && pnpm ci:frontend-api-closure:strict && pnpm check:forbidden-scope && pnpm check:secrets && pnpm db:sql:check && pnpm db:migrate:check && pnpm db:rls:check && pnpm build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "postinstall": "prisma generate --config backend/prisma.generate.config.ts",
    "prepare": "husky",
    "precommit": "pnpm check:env && pnpm exec lint-staged --concurrent 1 && pnpm typecheck",
    "prepush": "pnpm test:unit && pnpm check:route-metadata && pnpm check:prisma-boundary",
    "check:env": "node scripts/guards/prevent-env-commit.mjs",
    "check:route-metadata": "node scripts/guards/check-route-metadata.mjs",
    "check:prisma-boundary": "node scripts/guards/check-prisma-boundary.mjs",
    "check:audit-compliance": "node scripts/guards/check-audit-compliance.mjs",
    "check:outbox-compliance": "node scripts/guards/check-outbox-compliance.mjs",
    "check:forbidden-scope": "node scripts/guards/check-forbidden-scope.mjs",
    "check:secrets": "node scripts/guards/check-secrets.mjs",
    "db:sql:check": "node scripts/db/check-no-session-tenant-set.mjs && node scripts/db/check-sql-approved-paths.mjs",
    "db:sql:apply": "dotenv -e .env.local -- node scripts/db/apply-sql-directory.mjs",
    "db:cleanup-test-tenants": "node scripts/db/purge-test-tenants.mjs",
    "db:test:setup": "node scripts/db/setup-test-db.mjs",
    "db:test:cleanup:init": "node scripts/db/initialize-test-cleanup.mjs",
    "test:cleanup-boundary": "node --test scripts/db/test-cleanup-boundary.test.mjs",
    "test:cleanup-postgres": "node scripts/db/verify-test-cleanup.mjs",
    "db:check-no-leaked-test-tenants": "dotenv -e .env.test -- node scripts/db/check-no-leaked-test-tenants.mjs",
    "data:encrypt-affiliate-payouts": "tsx scripts/data/encrypt-affiliate-payout-details.ts",
    "data:sanitize-svg-assets": "tsx scripts/data/sanitize-stored-svg-assets.ts",
    "db:check-no-direct-prisma": "tsx scripts/check-no-direct-prisma.ts",
    "db:check-no-session-tenant-set": "node scripts/db/check-no-session-tenant-set.mjs",
    "db:check-no-platform-scope-outside-wrapper": "tsx scripts/check-no-platform-scope-outside-wrapper.ts",
    "db:seed:catalogues": "dotenv -e .env.local -- tsx backend/prisma/seeds/index.ts catalogues",
    "db:seed:tenants": "dotenv -e .env.local -- tsx backend/prisma/seeds/index.ts tenants",
    "db:seed:fundedbeyond": "dotenv -e .env.local -- tsx backend/prisma/seeds/index.ts fundedbeyond",
    "db:seed:smoke-tenant": "dotenv -e .env.local -- tsx backend/prisma/seeds/index.ts smoke-tenant",
    "db:seed:fundedbeyond-branding": "node scripts/db/seed-fundedbeyond-branding.mjs",
    "db:seed:check": "pnpm tenant-config:validate -- --tenant fundedbeyond && pnpm tenant-config:validate -- --tenant second-smoke-academy",
    "tenant-config:validate": "tsx scripts/tenants/validate.ts",
    "tenant-config:plan": "tsx scripts/tenants/plan.ts",
    "tenant-config:apply": "dotenv -e .env.local -- tsx scripts/tenants/apply.ts",
    "tenant-config:verify": "tsx scripts/tenants/verify.ts",
    "tenant-config:smoke": "dotenv -e .env.local -- tsx scripts/tenants/smoke.ts",
    "db:provision": "node scripts/db/provision-database.mjs",
    "db:provision:local": "dotenv -e .env.local -- node scripts/db/provision-database.mjs",
    "db:rls:check": "dotenv -e .env.local -- tsx scripts/check-rls-state.ts",
    "db:rls:check:ci": "tsx scripts/check-rls-state.ts",
    "db:tenant-indexes:check": "dotenv -e .env.local -- tsx scripts/check-tenant-leading-indexes.ts",
    "db:append-only:check": "dotenv -e .env.local -- tsx scripts/check-append-only-trigger-coverage.ts",
    "sprint0:gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tenant-isolation && pnpm db:check-no-leaked-test-tenants && pnpm db:rls:check && pnpm db:tenant-indexes:check && pnpm db:append-only:check && pnpm db:check-no-direct-prisma && pnpm db:check-no-platform-scope-outside-wrapper && pnpm db:check-no-session-tenant-set",
    "ci:route-metadata": "pnpm check:route-metadata",
    "ci:zod-boundaries": "tsx scripts/ci/check-zod-boundaries.ts",
    "ci:permission-metadata": "tsx scripts/ci/check-permission-metadata.ts",
    "ci:entitlement-metadata": "tsx scripts/ci/check-entitlement-metadata.ts",
    "ci:prisma-boundary": "pnpm check:prisma-boundary",
    "ci:audit-metadata": "tsx scripts/ci/check-sensitive-route-audit.ts",
    "ci:mfa-metadata": "tsx scripts/ci/check-sensitive-route-mfa.ts",
    "ci:outbox-metadata": "pnpm check:outbox-compliance",
    "ci:tenant-resource-registry": "tsx scripts/ci/check-tenant-resource-registry.ts",
    "ci:forbidden-scope": "pnpm check:forbidden-scope",
    "security:check": "node scripts/security/check.mjs",
    "security:supabase-auth": "node scripts/security/verify-supabase-auth-config.mjs",
    "test:rls": "dotenv -e .env.test -- vitest run tests/tenant-isolation/rls-direct-query.test.ts tests/tenant-isolation/transaction-pooling.test.ts tests/db",
    "test:storage": "dotenv -e .env.test -- vitest run tests/security/storage-secret-leakage.test.ts tests/tenant-isolation/storage-key-isolation.test.ts",
    "release:suite": "node scripts/release/run-suite.mjs",
    "release:restore:validate": "node scripts/release/restore-validate.mjs",
    "release:restore:drill": "node scripts/release/restore-drill.mjs",
    "release:evidence:validate": "node scripts/release/validate-evidence.mjs",
    "perf:exam-window": "tsx --tsconfig backend/apps/api/tsconfig.json scripts/perf/exam-window-load.ts",
    "perf:http": "node scripts/perf/http-workload.mjs",
    "perf:local": "node scripts/perf/local-smoke.mjs",
    "perf:build": "node scripts/perf/local-web.mjs build",
    "perf:mobile": "node scripts/e2e/local-run.mjs test --config playwright.performance.config.mjs",
    "perf:web-vitals": "playwright test --config playwright.web-vitals.config.mjs",
    "perf:budget": "node scripts/perf/connection-budget.mjs",
    "perf:telemetry": "node scripts/perf/telemetry.mjs",
    "perf:tooling-tests": "node --test scripts/perf/*.test.mjs tests/performance/*.test.mjs",
    "release:rollback:verify": "node scripts/release/rollback-verify.mjs",
    "observability:check": "node scripts/observability/check-contract.mjs",
    "observability:validate-env": "node scripts/observability/validate-env.mjs",
    "release:health": "node scripts/observability/release-health.mjs",
    "test:workers": "pnpm test:events",
    "db:setup-login-roles": "node scripts/db/setup-login-roles.mjs",
    "db:setup-login-roles:local": "dotenv -e .env.local -- node scripts/db/setup-login-roles.mjs",
    "worker:outbox": "dotenv -e .env.local -- tsx --tsconfig backend/apps/api/tsconfig.json backend/apps/api/src/worker/index.ts",
    "worker:outbox:prod": "tsx --tsconfig backend/apps/api/tsconfig.json backend/apps/api/src/worker/index.ts",
    "check:package-exports": "node scripts/guards/check-package-exports.mjs",
    "check:outbox-worker": "node scripts/guards/check-outbox-worker-coverage.mjs",
    "check:server-authority": "node scripts/guards/check-server-authority.mjs",
    "check:contracts": "node scripts/sync-contracts.mjs --check",
    "test:architecture": "node --test scripts/guards/server-authority.test.mjs scripts/sync-contracts.test.mjs scripts/guards/generated-output.test.mjs scripts/guards/local-font-assets.test.mjs scripts/guards/check-secrets.test.mjs scripts/e2e/verify-failure-probes.test.mjs",
    "test:performance-tooling": "node --test scripts/perf/*.test.mjs tests/performance/*.test.mjs",
    "test:reliability-tooling": "node --test scripts/release/restore-drill.test.mjs scripts/reliability/alerts-rollback-verifiers.test.mjs scripts/reliability/seed-restore-fixture.test.mjs scripts/db/migration-verification.test.mjs",
    "test:supabase-security": "node scripts/security/verify-f19-event-trigger.mjs",
    "test:scorm-browser": "node scripts/security/verify-scorm-runtime-bridge.mjs",
    "db:proctoring-integrity:check": "node scripts/db/check-proctoring-integrity.mjs",
    "db:tenant-fk:check": "node scripts/db/check-tenant-fk-integrity.mjs",
    "test:proctoring-integrity": "node scripts/db/verify-proctoring-integrity.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "next": "^16.3.7",
    "pg": "^8.21.0",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@atlas/access": "workspace:*",
    "@atlas/db": "workspace:*",
    "@atlas/release-readiness": "workspace:*",
    "@atlas/tenant-config": "workspace:*",
    "@supabase/supabase-js": "^2.108.2",
    "uuid": "^14.0.0"
  }
}
