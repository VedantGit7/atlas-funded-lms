{
  "name": "atlas-lms",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas LMS multi-tenant white-label learning platform",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "pnpm -r test && dotenv -e .env.local -- vitest run tests/db",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "dotenv -e .env.local -- vitest run tests/db",
    "test:authorization": "pnpm -r test:authorization",
    "test:tenant-isolation": "dotenv -e .env.local -- vitest run tests/tenant-isolation",
    "test:e2e": "pnpm -r test:e2e",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:generate:ci": "prisma generate --config prisma.config.ts",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:check": "node scripts/guards/check-migrate-status.mjs",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "tsx prisma/seeds/index.ts all",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:route-metadata && pnpm check:prisma-boundary && pnpm check:audit-compliance && pnpm check:outbox-compliance && pnpm check:forbidden-scope && pnpm check:secrets && pnpm db:sql:check && pnpm db:migrate:check && pnpm db:rls:check && pnpm build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "precommit": "pnpm check:env && pnpm exec lint-staged && pnpm typecheck",
    "prepush": "pnpm test:unit && pnpm check:route-metadata && pnpm check:prisma-boundary",
    "check:env": "node scripts/guards/prevent-env-commit.mjs",
    "check:route-metadata": "node scripts/guards/check-route-metadata.mjs",
    "check:prisma-boundary": "node scripts/guards/check-prisma-boundary.mjs",
    "check:audit-compliance": "node scripts/guards/check-audit-compliance.mjs",
    "check:outbox-compliance": "node scripts/guards/check-outbox-compliance.mjs",
    "check:forbidden-scope": "node scripts/guards/check-forbidden-scope.mjs",
    "check:secrets": "node scripts/guards/check-secrets.mjs",
    "db:sql:check": "node scripts/db/check-no-session-tenant-set.mjs && node scripts/db/check-sql-approved-paths.mjs",
    "db:sql:apply": "dotenv -e .env.local -- node scripts/db/apply-sql-directory.mjs",
    "db:check-no-direct-prisma": "tsx scripts/check-no-direct-prisma.ts",
    "db:check-no-session-tenant-set": "node scripts/db/check-no-session-tenant-set.mjs",
    "db:check-no-platform-scope-outside-wrapper": "tsx scripts/check-no-platform-scope-outside-wrapper.ts",
    "db:seed:catalogues": "tsx prisma/seeds/index.ts catalogues",
    "db:seed:tenants": "tsx prisma/seeds/index.ts tenants",
    "db:seed:fundedbeyond": "tsx prisma/seeds/index.ts fundedbeyond",
    "db:seed:smoke-tenant": "tsx prisma/seeds/index.ts smoke-tenant",
    "db:rls:check": "dotenv -e .env.local -- tsx scripts/check-rls-state.ts",
    "db:tenant-indexes:check": "dotenv -e .env.local -- tsx scripts/check-tenant-leading-indexes.ts",
    "db:append-only:check": "dotenv -e .env.local -- tsx scripts/check-append-only-trigger-coverage.ts",
    "sprint0:gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tenant-isolation && pnpm db:rls:check && pnpm db:tenant-indexes:check && pnpm db:append-only:check && pnpm db:check-no-direct-prisma && pnpm db:check-no-platform-scope-outside-wrapper && pnpm db:check-no-session-tenant-set"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "pg": "^8.21.0",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.18"
  }
}
