# Normalise line endings in the repository to LF.
#
# Without this, the working tree depends on each developer's core.autocrlf, so
# the same file can be CRLF on Windows and LF on Linux. Prettier is configured
# with endOfLine: "auto" and tolerates either, but line-ending churn still shows
# up as whole-file diffs in review and makes `git blame` useless.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.mp4 binary
*.webm binary

# Generated — exclude from diffs and language stats.
pnpm-lock.yaml linguist-generated=true -diff
backend/packages/db/src/generated/** linguist-generated=true -diff
