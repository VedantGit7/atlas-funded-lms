# Atlas LMS environment placeholder file
# Do not put real secrets in this file.

APP_ENV=
APP_URL=
PLATFORM_HOST=
# Comma-separated platform operator assignments: email=super_admin|operations|support
PLATFORM_OPERATOR_ASSIGNMENTS=

DATABASE_URL=
DIRECT_DATABASE_URL=
PLATFORM_DATABASE_URL=

# Local example:
# DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:54329/atlas_lms_dev?schema=public
# DIRECT_DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:54329/atlas_lms_dev?schema=public
# PLATFORM_DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:54329/atlas_lms_dev?schema=public
# Requires: GRANT atlas_app TO atlas; GRANT atlas_platform TO atlas; and CREATE EXTENSION IF NOT EXISTS pgcrypto;

SUPABASE_URL=
