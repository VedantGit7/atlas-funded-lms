# Atlas LMS environment placeholder file
# Do not put real secrets in this file.

# Local template only. Deployed Node/Vercel runtimes require an explicit
# APP_ENV=production or staging and the contract in docs/runbooks/deployment-configuration.md.
# Validate injected settings with pnpm check:deployment api (also web / worker).
APP_ENV=development
# Deployed API and worker only: ATLAS_SERVICE_RUNTIME=managed-node
# See docs/runbooks/managed-node-runtime.md for the persistent service contract.
APP_URL=
PLATFORM_HOST=
API_INTERNAL_URL=
PUBLIC_SITE_URL=
# Platform authority comes only from active platform_operators database grants.
# PLATFORM_OPERATOR_ASSIGNMENTS is retired and has no runtime effect (F02).
# For controlled bootstrap/recovery and legacy tenant-access review, see
# docs/runbooks/platform-operator-access.md. Tenant roles require separate grants.

DATABASE_URL=
DIRECT_DATABASE_URL=
PLATFORM_DATABASE_URL=

# Local example:
# DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:15432/atlas_lms_dev?schema=public
# DIRECT_DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:15432/atlas_lms_dev?schema=public
# PLATFORM_DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:15432/atlas_lms_dev?schema=public
# Requires: GRANT atlas_app TO atlas; GRANT atlas_platform TO atlas; and CREATE EXTENSION IF NOT EXISTS pgcrypto;
#
# Automated tests must NOT run against the dev database. Create a local .env.test
# (gitignored) pointing at a separate database, then run `pnpm db:test:setup` to
# provision it (clones the dev schema + seeds catalogues). DB-backed test scripts
# (test, test:integration, test:tenant-isolation, test:e2e) load .env.test.
# Example .env.test:
# DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:15432/atlas_lms_test?schema=public
# DIRECT_DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:15432/atlas_lms_test?schema=public
# PLATFORM_DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:15432/atlas_lms_test?schema=public

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Browser/server auth consumers use these public names. Never put a service-role
# or sb_secret_ key in NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_ENDPOINT=

SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

POSTHOG_KEY=
# Prefer EU for this project (eu.posthog.com). Legacy alias; prefer POSTHOG_SERVER_HOST below.
POSTHOG_HOST=https://eu.i.posthog.com

BETTER_STACK_SOURCE_TOKEN=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

CRON_SECRET=
INTERNAL_WORKER_SECRET=
# Dedicated web-to-API forwarding credential; same value on web/API only.
# Required in staging/production, >=32 random characters, distinct from cron/worker.
API_PROXY_SECRET=

STORAGE_PROVIDER=local-fs
# Deployed runtimes require STORAGE_PROVIDER=r2 and all four R2 account/access/
# secret/bucket variables above. Upload/download TTLs must be 60..900 seconds.
# Use an ABSOLUTE path. This is resolved with `path.resolve(process.cwd(), ...)`,
# and the processes that touch local storage do not share a working directory:
# the API dev server runs from backend/apps/api (via `pnpm --filter`), the outbox
# worker and seed scripts run from the repo root. A relative value therefore
# points each of them at a different `.storage`, and an asset written by one is
# a 500 in another. Example: D:/code/atlas-funded-lms/.storage
STORAGE_LOCAL_ROOT=.storage
STORAGE_LOCAL_DOWNLOAD_BASE_PATH=/api/v1/storage/local/download
# Empty uses the development-only default locally. Leave this unused setting
# unset in R2 deployments; explicitly supplying the development secret fails startup.
STORAGE_LOCAL_SIGNING_SECRET=

STORAGE_SIGNED_UPLOAD_TTL_SECONDS=300
STORAGE_SIGNED_DOWNLOAD_TTL_SECONDS=300
STORAGE_MAX_BRANDING_ASSET_BYTES=2000000
STORAGE_MAX_LESSON_ASSET_BYTES=100000000

# Release identity
RELEASE_ENV=
RELEASE_SHA=
RELEASE_VERSION=

# Server-only observability correlation
OBSERVABILITY_HASH_SALT=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=

# PostHog (EU project — defaults in code are https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_SERVER_KEY=
POSTHOG_SERVER_HOST=https://eu.i.posthog.com

# Better Stack
BETTER_STACK_WORKER_HEARTBEAT_URL=

# Release health probe target. Consumed by `pnpm release:health` (or its
# --base-url flag), by release:restore:validate, and by release:suite, which
# reports RELEASE_HEALTH_BASE_URL as unconfigured when this is empty.
RELEASE_HEALTH_BASE_URL=
# Mandatory immutable release identity for release:health and inherited smoke/restore checks.
RELEASE_HEALTH_EXPECTED_RELEASE=
# Optional per-probe timeout, in milliseconds (100-30000).
RELEASE_HEALTH_TIMEOUT_MS=10000
# Optional server/CI-only preview automation access. Never use a NEXT_PUBLIC_ name.
VERCEL_AUTOMATION_BYPASS_SECRET=

# E2E browser credentials.
#
# Ten of the eleven journeys need a session. Unset, they skip — fine on a
# laptop, useless in a pipeline, where a skip reads as a pass. Set
# # The browser suite runs against a production build by default, which is what
# users get and hydrates in about a second. Set BROWSER_E2E_DEV=1 to use the dev
# server instead for a fast edit-and-rerun loop; expect the first hit on each
# route to spend ten to twenty seconds compiling.
BROWSER_E2E_DEV=
E2E_REQUIRE_AUTH_JOURNEYS=1 (CI does) to turn a missing credential into a
# failure that names the variable instead.
#
# Create the users with: pnpm e2e:seed-users -- --tenant=<slug>
# (needs SUPABASE_SERVICE_ROLE_KEY and E2E_SEED_PASSWORD).
E2E_REQUIRE_AUTH_JOURNEYS=
E2E_TENANT_SLUG=
E2E_SEED_PASSWORD=
E2E_TENANT_BASE_URL=http://fundedbeyond.localhost.test:3000
E2E_PLATFORM_BASE_URL=http://platform.localhost:3000
E2E_SECOND_TENANT_BASE_URL=http://second-smoke.localhost.test:3000
E2E_LEARNER_EMAIL=
E2E_LEARNER_PASSWORD=
E2E_INSTRUCTOR_EMAIL=
E2E_INSTRUCTOR_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PLATFORM_EMAIL=
E2E_PLATFORM_PASSWORD=
OBSERVABILITY_SMOKE_ENABLED=
# Payment gateway secret encryption key: AES-256-GCM, base64-encoded 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Provision from a secrets manager / KMS in production.
LEARNER_BILLING_ENC_KEY=

# Stripe webhook signing secret (required when Stripe is the published payment gateway).
STRIPE_WEBHOOK_SECRET=

# Razorpay webhook signing secret (required when Razorpay is the published payment gateway).
RAZORPAY_WEBHOOK_SECRET=

# Live FX rate provider (ECB data via Frankfurter). Override for self-hosting or
# tests; defaults to https://api.frankfurter.app/latest when unset. The daily
# refresh cron (vercel.json -> /api/v1/internal/fx/refresh) is authorised with
# CRON_SECRET above.
FX_PROVIDER_URL=

# Certificate Builder / credentials (feature flags)
# Open Badge 3.0 issuance on by default; set to "false" to disable.
CERTIFICATE_OPEN_BADGE=
# Apple/Google Wallet pass generation (requires platform credentials when enabled).
CERTIFICATE_WALLETS=
# Local sha256 anchor always; set true to attempt on-chain adapters below.
CERTIFICATE_BLOCKCHAIN_ANCHOR=
# Chain adapter when anchoring is enabled: local | op_return | evm (default local).
CERTIFICATE_CHAIN_ADAPTER=local
# Bitcoin Core JSON-RPC for OP_RETURN adapter (optional; degrades to local when unset).
CERTIFICATE_BTC_RPC_URL=
CERTIFICATE_BTC_RPC_USER=
CERTIFICATE_BTC_RPC_PASSWORD=
# EVM JSON-RPC + funded private key for evm adapter (optional; degrades to local when unset).
CERTIFICATE_EVM_RPC_URL=
CERTIFICATE_EVM_PRIVATE_KEY=
# Optional destination for EVM anchor txs (defaults to the signer address).
CERTIFICATE_EVM_TO_ADDRESS=
# Enable Playwright PDF worker when configured (set true in envs that drain PDF jobs).
CERTIFICATE_PDF_WORKER=true
# Learning-path certificate settings surface.
CERTIFICATE_LEARNING_PATH=
# Ed25519 PEM for signing Open Badge / VC JSON. Required in deployed runtimes
# unless CERTIFICATE_OPEN_BADGE=false; unsigned fallback is local only.
CERTIFICATE_ISSUER_PRIVATE_KEY=
CERTIFICATE_ISSUER_DID=
# Public origin used in verification / wallet barcode URLs (no trailing slash).
CERTIFICATE_PUBLIC_BASE_URL=

# Apple Wallet (.pkpass) — all five required when CERTIFICATE_WALLETS=true for Apple.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_WWDR_PEM=
APPLE_WALLET_ORGANIZATION_NAME=

# Google Wallet — issuer id + service account JSON string when enabling Google saves.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Optional Generic class id (defaults to {issuerId}.certificate).
GOOGLE_WALLET_CLASS_ID=

# Native IAP receipt verification (mobile unlock)
# App Store shared secret for legacy verifyReceipt; optional for StoreKit 2 JWT decode + sandbox: fixtures.
APPLE_IAP_SHARED_SECRET=
APPLE_IAP_BUNDLE_ID=
# Google Play service account JSON string + default package name. Without these, sandbox: tokens are accepted.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=


# ---------------------------------------------------------------------------
# Email transport (Phase 2 / audit C7)
# ---------------------------------------------------------------------------
# "smtp" is REQUIRED in all deployed runtimes; the process refuses
# to start otherwise, because a mock provider silently discards password resets
# and signup verification. Use "mock" for local development.
# Any provider works — Resend, SES, SendGrid, Postmark and Mailgun all expose SMTP.
NOTIFICATION_EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
# Deployed SMTP requires credentials and TLS (implicit on 465, STARTTLS otherwise).

# Support address shown on public screens (verify-email) for tenants that have
# not configured their own under tenant settings -> channels -> supportEmail.
# Optional: when neither is set the contact line is hidden. Do NOT put one
# tenant's address here — every other tenant's learners would be sent to it.
PLATFORM_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Rate limiting (audit F04; docs/runbooks/rate-limiting.md)
# ---------------------------------------------------------------------------
# Shared counter store. REQUIRED when NODE_ENV=production OR APP_ENV is
# production/staging. Both app runtimes reject missing/invalid configuration.
# Use the same redis:// or rediss:// database for both apps and all replicas.
# RATE_LIMIT_REDIS_URL overrides REDIS_URL. Configured outages return 503 with
# Retry-After: 5; there is no per-process outage fallback.
REDIS_URL=
RATE_LIMIT_REDIS_URL=
# Web ingress trusts no forwarding headers by default. Set the verified number
# of edge proxies appending x-forwarded-for; selection counts from the RIGHT.
# Deployed public/browser API requests fail closed with 503 without attribution.
# Configure the real edge path and restrict origin access before rollout.
TRUSTED_PROXY_HOPS=0
# Optional single-value header set by the edge (e.g. cf-connecting-ip behind
# Cloudflare). Takes precedence over x-forwarded-for when set. Only trust a
# header your edge overwrites; restrict direct origin access so it cannot be spoofed.
TRUSTED_CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# Outbox worker (Phase 2 / audit C6) — run with `pnpm worker:outbox`
# ---------------------------------------------------------------------------
# Idle poll interval. The worker skips this wait while a backlog is draining.
OUTBOX_WORKER_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_LIMIT=25
OUTBOX_WORKER_MAX_RETRIES=3
# Serves /healthz (liveness) and /readyz (readiness).
OUTBOX_WORKER_HEALTH_PORT=8081
# Hard deadline for draining in-flight work after SIGTERM. Keep it below the
# orchestrator's termination grace period.
OUTBOX_WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Per-tenant usage metering for cost attribution (API requests and emails,
# flushed to analytics_rollups every 60s). On by default; "off" disables it in
# this process. See docs/runbooks/cost-attribution.md.
ATLAS_USAGE_METERING=on

# ---------------------------------------------------------------------------
# Database login roles (Phase 2 / audit C5)
# ---------------------------------------------------------------------------
# DATABASE_URL must connect as atlas_app_login and PLATFORM_DATABASE_URL as
# atlas_platform_login. Both are NOSUPERUSER NOBYPASSRLS, which is what makes
# row-level security an actual backstop: a query that forgets withTenantTx
# returns zero rows instead of every tenant's data. Connecting as a superuser
# (rolbypassrls) silently disables all 219 tenant policies.
# Deployed URLs also require sslmode=require, verify-ca or verify-full. Prefer
# verify-full with a trusted certificate. Runtime URL query parameters are limited
# to sslmode, schema, pgbouncer, connection_limit and pool_timeout, without duplicates.
# The contract checks login names; verify actual role grants/RLS on the live database.
#
# atlas_app_login is deliberately NOT a member of atlas_platform — that role's
# policy is USING (true), so granting it would re-open cross-tenant reads.
#
# Set the passwords once with:
#   ATLAS_APP_LOGIN_PASSWORD=... ATLAS_PLATFORM_LOGIN_PASSWORD=... \
#     pnpm db:setup-login-roles:local
# then put the same values into the two connection strings below.
DATABASE_URL="postgresql://atlas_app_login:<password>@localhost:15432/atlas_lms_dev?schema=public"
PLATFORM_DATABASE_URL="postgresql://atlas_platform_login:<password>@localhost:15432/atlas_lms_dev?schema=public"

# F17: pg pools are configured per process. Validate the sum across all maximum
# web/API/worker instances with `pnpm perf:budget <budget.json>` before sizing.
# Prisma URL connection_limit/pool_timeout do not configure these pg Pool objects.
DATABASE_POOL_MAX=20
PLATFORM_DATABASE_POOL_MAX=10
# Independent bounded metering pool; include it for every process in capacity budgets.
USAGE_DATABASE_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=10000
PLATFORM_DATABASE_CONNECTION_TIMEOUT_MS=10000
# Opt-in safe aggregate timings every 60 seconds; no SQL, params or credentials.
DATABASE_POOL_METRICS=0
# Local development only: set to 1 temporarily when diagnosing SQL. Deployed runtimes never log queries.
DATABASE_QUERY_LOGS=0

# Consumed only by scripts/db/setup-login-roles.mjs when setting the passwords.
ATLAS_APP_LOGIN_PASSWORD=
ATLAS_PLATFORM_LOGIN_PASSWORD=

# .env.test only. The tenant-isolation backstop tests SKIP without this, so
# nothing guards the RLS backstop against regression until it is set. CI passes
# it to the tenant-isolation job explicitly for the same reason.
ATLAS_APP_LOGIN_URL=

# F20: database test runs also require separate cleanup credentials and a UUID
# marker initialized only in a disposable test database. Do not put cleanup
# credentials in this application environment. Configure .env.test using
# docs/runbooks/test-database-cleanup.md; uninitialized database tests fail closed.

# Makes check-rls-state.ts fail, rather than warn, when the connecting role can
# bypass RLS. Implied by APP_ENV=production; set it by hand anywhere else that
# must not connect as a superuser.
REQUIRE_NON_SUPERUSER_DB=

# Domain suffix shown beside the slug field when creating a sub-school, e.g.
# ".academy.example.com". Hardcoding it leaks one tenant domain to all academies.
NEXT_PUBLIC_SUB_SCHOOL_URL_SUFFIX=

# Tenant webhook egress (audit F06; docs/runbooks/outbound-webhooks.md).
# Optional exact, comma-separated hostnames (lowercase/punycode; IPv6 in brackets).
# No schemes, paths, ports, suffix rules or wildcards. Empty permits public hosts.
# An allowed hostname must still resolve only to approved public IP addresses.
# Apply consistently to web/API/worker; this does not configure a network firewall.
OUTBOUND_ALLOWED_HOSTS=

# Browser CSP (F13; docs/runbooks/content-security-policy.md).
# Start with reports; set 1 only after the candidate's provider/journey checks.
# Both modes issue fresh script nonces. Only 0 and 1 are supported.
CSP_ENFORCE=0
# Optional comma/space-separated exact HTTPS origins, no wildcard/path/query.
# Provider origins are also derived from configured Supabase, browser Sentry,
# PostHog and R2 URLs. Empty lists do not grant blanket HTTPS permissions.
CSP_SCRIPT_ORIGINS=
CSP_IMAGE_ORIGINS=
CSP_MEDIA_ORIGINS=
CSP_CONNECT_ORIGINS=
CSP_FRAME_ORIGINS=
