{
  "name": "@atlas/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./global-db": "./src/global-db.ts",
    "./with-tenant-tx": "./src/with-tenant-tx.ts",
    "./generated/prisma/client": "./src/generated/prisma/client"
  },
  "scripts": {
    "build": "echo \"No db build configured yet.\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"No db tests configured yet.\"",
    "test:unit": "echo \"No db unit tests configured yet.\"",
    "test:integration": "echo \"No db integration tests configured yet.\"",
    "test:authorization": "echo \"No db authorization tests configured yet.\"",
    "test:tenant-isolation": "echo \"No db tenant-isolation tests configured yet.\"",
    "test:e2e": "echo \"No db e2e tests configured yet.\"",
    "db:generate": "dotenv -e ../../.env.local -- prisma generate --config ../../prisma.config.ts",
    "db:validate": "dotenv -e ../../.env.local -- prisma validate --config ../../prisma.config.ts",
    "db:migrate": "dotenv -e ../../.env.local -- prisma migrate dev --config ../../prisma.config.ts",
    "db:migrate:check": "node ../../scripts/guards/check-migrate-status.mjs",
    "db:seed": "echo \"Seed skeleton is not configured yet.\""
  },
  "dependencies": {
    "@atlas/audit": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3"
  }
}
